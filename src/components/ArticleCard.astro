---
import { contentTypeLabel } from '../data/editorial';

const { article } = Astro.props;
const date = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(article.data.publishedAt);
const articleHref = `/artikel/${article.data.slug}/`;
---
<article class="article-card">
  <a class="article-card__media" style="aspect-ratio:16/9;overflow:hidden;" href={articleHref} aria-label={`Baca: ${article.data.title}`}>
    <img
      src={article.data.featuredImage}
      alt={article.data.featuredImageAlt}
      width="1536"
      height="864"
      loading="lazy"
      decoding="async"
      style="display:block;width:100%;height:100%;object-fit:contain;object-position:center;"
    />
    <span class="content-type-badge">{contentTypeLabel(article.data.contentType)}</span>
  </a>
  <div class="article-card__body">
    <div class="eyebrow">
      <a href={`/kategori/${article.data.categorySlug}/`}>{article.data.category}</a>
      <span>•</span>
      <time datetime={article.data.publishedAt.toISOString()}>{date}</time>
    </div>
    <h3><a href={articleHref}>{article.data.title}</a></h3>
    <p>{article.data.description}</p>
    <a class="text-link" href={articleHref}>Baca panduan <span aria-hidden="true">→</span></a>
  </div>
</article>
