---
import { NAV } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="TeknoPraktis — Beranda">
      <img src="/brand/teknopraktis-mark.svg" width="42" height="42" alt="" />
      <span>Tekno<span>Praktis</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Navigasi utama">
      <ul class="nav-list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-cta" href="/tentang/" aria-current={isCurrent('/tentang/') ? 'page' : undefined}>Tentang kami</a>

    <details class="mobile-menu">
      <summary aria-label="Buka navigasi utama">Menu</summary>
      <nav aria-label="Navigasi utama seluler">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li><a href="/tentang/" aria-current={isCurrent('/tentang/') ? 'page' : undefined}>Tentang kami</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
