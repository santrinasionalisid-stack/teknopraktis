---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES } from '../../data/editorial';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const articles = (await getCollection('articles', ({ data }) =>
  !data.draft && data.categorySlug === category.slug
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title={category.name} description={category.description}>
  <section class="page-hero">
    <div class="container">
      <span class="kicker">Kategori</span>
      <h1>{category.name}</h1>
      <p>{category.description}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {articles.length > 0
        ? <div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div>
        : <div class="empty-state"><strong>Panduan sedang disiapkan.</strong><p>Belum ada artikel terbit dalam kategori ini.</p></div>}
    </div>
  </section>
</BaseLayout>
