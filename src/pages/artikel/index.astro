---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<BaseLayout title="Artikel" description="Kumpulan panduan teknologi praktis TeknoPraktis: AI, aplikasi, keamanan digital, internet, dan produktivitas."><section class="page-hero"><div class="container"><span class="kicker">Pusat panduan</span><h1>Artikel TeknoPraktis</h1><p>Temukan tutorial, penjelasan, dan panduan keputusan teknologi yang dibuat untuk pengguna Indonesia.</p></div></section><section class="section"><div class="container"><div class="article-grid">{articles.map((article)=><ArticleCard article={article}/>)}</div></div></section></BaseLayout>
