---
import BaseLayout from './BaseLayout.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { SITE } from '../data/site';
import { contentTypeLabel } from '../data/editorial';

const { article, related = [], headings = [] } = Astro.props;
const d = article.data;
const published = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(d.publishedAt);

const modified = d.updatedAt
  ? new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.updatedAt)
  : null;

const articleUrl = `${SITE.url}/artikel/${d.slug}/`;
const imageUrl = new URL(d.socialImage ?? d.featuredImage, SITE.url).toString();
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const typeLabel = contentTypeLabel(d.contentType);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: [imageUrl],
  datePublished: d.publishedAt.toISOString(),
  dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
  inLanguage: 'id-ID',
  isAccessibleForFree: true,
  author: { '@type': 'Organization', name: d.author, url: `${SITE.url}/redaksi/` },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/teknopraktis-mark.svg` },
  },
  mainEntityOfPage: articleUrl,
  articleSection: d.category,
  genre: typeLabel,
  keywords: d.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Panduan', item: `${SITE.url}/panduan/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: articleUrl },
  ],
};
---
<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  image={d.socialImage ?? d.featuredImage}
  imageAlt={d.featuredImageAlt}
  type="article"
  schema={[articleSchema, breadcrumbSchema]}
>
  <article class="article-shell" data-ui-version="editorial-remediation-20261008-v3">
    <header class="article-hero container prose-width">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a><span aria-hidden="true">/</span><a href="/panduan/">Panduan</a>
      </nav>
      <div class="eyebrow">
        <a href={`/kategori/${d.categorySlug}/`}>{d.category}</a>
        <span>•</span>
        <span>{typeLabel}</span>
        <span>•</span>
        <time datetime={d.publishedAt.toISOString()}>{published}</time>
        {modified && <><span>•</span><span>Diperbarui {modified}</span></>}
      </div>
      <h1>{d.title}</h1>
      <p class="article-deck" style="text-align: justify !important; text-justify: inter-word;">{d.description}</p>
      <div class="article-byline">
        <strong><a href="/redaksi/">{d.author}</a></strong>
        <span>{d.reviewedBy ? `Ditinjau oleh ${d.reviewedBy}.` : 'Ditinjau untuk kejelasan dan akurasi praktis.'}</span>
      </div>
      {d.sponsored && <p class="disclosure"><strong>Disclosure komersial:</strong> Konten ini memiliki hubungan komersial yang dijelaskan secara transparan.</p>}
    </header>

    <figure
      class="article-featured container"
      style="aspect-ratio: 16 / 9; overflow: hidden;"
    >
      <img
        src={d.featuredImage}
        alt={d.featuredImageAlt}
        width="1536"
        height="864"
        decoding="async"
        style="display:block;width:100%;height:100%;object-fit:contain;object-position:center;"
      />
    </figure>

    <div class="article-guide-meta container prose-width" aria-label="Informasi panduan">
      <span><strong>{typeLabel}</strong></span>
      <span>{d.sources.length} sumber referensi</span>
      <span>{tocHeadings.length} bagian utama</span>
    </div>

    {tocHeadings.length >= 3 && (
      <nav class="article-toc container prose-width" aria-labelledby="toc-heading">
        <strong id="toc-heading">Di panduan ini</strong>
        <ol>
          {tocHeadings.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body container prose-width" style="text-align: justify !important; text-justify: inter-word;">
      <slot />
    </div>

    {d.sources.length > 0 && (
      <section class="article-sources container prose-width" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sumber & verifikasi</h2>
        <p>Referensi berikut digunakan untuk membantu memeriksa informasi dalam artikel ini.</p>
        <ol>
          {d.sources.map((source) => (
            <li><a href={source.url} rel="noreferrer">{source.title}</a></li>
          ))}
        </ol>
      </section>
    )}

    <footer class="article-footer container prose-width">
      <p><strong>Topik:</strong> {d.tags.join(' · ')}</p>
      <a class="button button--secondary" href="/panduan/">Lihat panduan lainnya</a>
    </footer>

    <div class="container related-wrap">
      <RelatedArticles articles={related} />
    </div>
  </article>

  <script is:inline>
    document.querySelectorAll('.article-deck, .article-body p, .article-body li').forEach((element) => {
      element.style.setProperty('text-align', 'justify', 'important');
      element.style.setProperty('text-align-last', 'left');
    });
  </script>
</BaseLayout>
